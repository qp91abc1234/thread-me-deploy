# ============================================
# Git 仓库配置
# ============================================
# 前端项目 Git 仓库地址
FRONTEND_REPO_URL=https://github.com/your-org/thread-me-admin.git
# 前端项目分支（可选，默认为 main）
FRONTEND_BRANCH=main

# 后端项目 Git 仓库地址
BACKEND_REPO_URL=https://github.com/your-org/thread-me-api.git
# 后端项目分支（可选，默认为 main）
BACKEND_BRANCH=main

# ============================================
# Docker 配置
# ============================================
# 前端镜像名称
FRONTEND_IMAGE_NAME=thread-me-admin
# 前端容器名称
FRONTEND_CONTAINER_NAME=thread-me-admin
# 前端端口
FRONTEND_PORT=80

# 后端镜像名称
BACKEND_IMAGE_NAME=thread-me-api
# 后端容器名称
BACKEND_CONTAINER_NAME=thread-me-api
# 后端端口
BACKEND_PORT=3000

# Docker 网络名称
DOCKER_NETWORK_NAME=thread-me-network

# ============================================
# 前端环境变量
# ============================================
# API 基础 URL
VITE_BASE_URL=/api

# ============================================
# 后端环境变量
# ============================================
# Node 环境
NODE_ENV=production

# 应用访问地址
APP_URL=http://your-domain.com

# JWT 配置
JWT_SECRET=your-jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRE_TIME=30m
JWT_REFRESH_TOKEN_EXPIRE_TIME=7d

# OAuth 配置
OAUTH_DEFAULT_PASSWORD=user123
OAUTH_DEFAULT_ROLE_NAME=general_user
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_SECRET=your-github-secret

# Winston 日志配置
WINSTON_MAX_FILES=14d
WINSTON_MAX_SIZE=10M

# 数据库配置
# 格式: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/thread_me_db

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# Throttler 限流配置
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# 阿里云 OSS 配置
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# QQ 邮箱配置（可选）
QQ_MAIL_AUTH_CODE=your-qq-mail-auth-code

# LangChain 配置
OPENAI_PROXY_KEY=your-openai-proxy-key
OPENAI_PROXY_URL=https://vip.apiyi.com/v1
ALI_KEY=your-ali-key

